# Library PDFs are large (CC-BY-NC-SA PanGlobal textbooks, ~474MB incl. a 111MB
# file > GitHub's 100MB limit). Served from a host volume mount, not git/image.
assets/library/*.pdf
# ...and the 4th Class part bundles built from them by
# scripts/build_library_bundles.py (~243MB and ~254MB). Build artefacts:
# a fresh clone will not have them, re-run the script on the host.
assets/library/*.zip

